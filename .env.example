# OrbitX - Environment Variables
# Copy this file to .env and configure your values

# === Campaign Settings ===
# Your X handle (without @)
X_HANDLE=your_x_handle

# Campaign start date (YYYY-MM-DD format, leave empty to start today)
CAMPAIGN_START_DATE=

# Total campaign days (default: 100)
CAMPAIGN_DAYS=100

# === Posting Schedule ===
# Timezone for scheduling (IANA format, e.g. America/New_York, Europe/London, Asia/Kathmandu)
TIMEZONE=UTC

# === Dashboard Settings ===
DASHBOARD_PORT=3847

# === Optional Browser Settings ===
# Leave blank to use default bundled Chromium, or set 'chrome' / 'msedge'
BROWSER_CHANNEL=
